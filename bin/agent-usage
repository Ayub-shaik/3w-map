#!/usr/bin/env python3
"""Summarise one sub-agent transcript: python3 agent-usage.py <agentId or file>. Prints tokens, tool calls, wall time."""
import json, sys, glob, datetime
a = sys.argv[1]
f = a if a.endswith(".output") or a.endswith(".jsonl") else (glob.glob(f"/tmp/claude-1000/*/*/tasks/{a}.output") or glob.glob(f"/tmp/claude-1000/**/{a}.output", recursive=True))[0]
seen, fresh, cr, out, tools, ts = {}, 0, 0, 0, 0, []
for l in open(f):
    try: d = json.loads(l)
    except Exception: continue
    if d.get("timestamp"): ts.append(d["timestamp"])
    m = d.get("message") or {}
    if m.get("role") == "assistant":
        u = m.get("usage") or {}; mid = m.get("id") or d.get("uuid")
        seen[mid] = u
        for c in (m.get("content") or []):
            if isinstance(c, dict) and c.get("type") == "tool_use" and mid not in seen.get("_t", set()): pass
tl = 0
ids = set()
for l in open(f):
    try: d = json.loads(l)
    except Exception: continue
    m = d.get("message") or {}
    if m.get("role") == "assistant":
        for c in (m.get("content") or []):
            if isinstance(c, dict) and c.get("type") == "tool_use" and c.get("id") not in ids: ids.add(c["id"]); tl += 1
for u in seen.values():
    fresh += (u.get("input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0); cr += u.get("cache_read_input_tokens") or 0; out += u.get("output_tokens") or 0
p = lambda s: datetime.datetime.fromisoformat(s.replace("Z", "+00:00"))
wall = (p(ts[-1]) - p(ts[0])).total_seconds() if len(ts) > 1 else 0
ctx=[(u.get('input_tokens') or 0)+(u.get('cache_creation_input_tokens') or 0)+(u.get('cache_read_input_tokens') or 0) for u in seen.values()]
growth=(ctx[-1]-ctx[0]) if ctx else 0
print(json.dumps(dict(growth=growth,rounds=len(seen), tools=tl, fresh_in=fresh, cache_read=cr, out=out, total_billed_like=fresh + out, wall_s=round(wall))))
