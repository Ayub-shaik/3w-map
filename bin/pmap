#!/usr/bin/env python3
"""pmap <repo> <cmd> ... : per-project decision map (3W: why / who / when) with a built-in token meter.
Data: <repo>/.claude/map/nodes.jsonl (git-tracked). Telemetry: ~/.claude/workspace/telemetry/pmap-<repo>.jsonl (not in git).
Node kinds: goal (G-*), driver (R-*, a law/rule/brief/spec that demands something), decision (<PFX>-NNN).
Links point UP only: serves (goal), required_by (driver, the "who"), triggered_by (decision/event, the "when" = cause), supersedes.
Effects are never stored: they are the reverse of those links (computed).
Commands: find <words> | why <id> [--expand who|when] [--depth N] | effects <id> [--top N] | open | add '<json>' | done <id> --commit H [--verified T]
          check | task "<title>" [--effort low|medium|high] | report [--last N] | snap <weekly%> <ctx%> | stat | bench"""
import json, subprocess, os, sys, time, re

def tok(s): return (len(s.encode()) + 3) // 4

def resolve_repo(a):
    if os.path.isdir(a): return os.path.abspath(a)
    # a bare name is looked up (3 levels deep) under PMAP_ROOTS (colon separated), default ~/projects:~/Desktop:~/src
    for root in os.environ.get("PMAP_ROOTS", "~/projects:~/Desktop:~/src").split(":"):
        root = os.path.expanduser(root)
        for r, ds, _ in os.walk(root):
            if os.path.basename(r) == a and os.path.isdir(os.path.join(r, ".git")): return r
            if r.count(os.sep) - root.count(os.sep) >= 3: ds[:] = []
    sys.exit(f"repo not found: {a} (pass a path, or set PMAP_ROOTS)")

class Map:
    def __init__(s, repo, mapdir=None, tele=None):
        s.repo = repo; s.name = os.path.basename(repo)
        s.dir = mapdir or os.path.join(repo, ".claude", "map"); os.makedirs(s.dir, exist_ok=True)
        s.file = os.path.join(s.dir, "nodes.jsonl")
        s.tele = tele or os.path.expanduser(f"~/.claude/workspace/telemetry/pmap-{s.name}.jsonl")
        os.makedirs(os.path.dirname(s.tele), exist_ok=True)
        s.nodes = {}
        if os.path.exists(s.file):
            for l in open(s.file):
                if l.strip(): n = json.loads(l); s.nodes[n["id"]] = n
    def save(s):
        with open(s.file, "w") as f:
            for k in sorted(s.nodes): f.write(json.dumps(s.nodes[k], separators=(",", ":"), ensure_ascii=False) + "\n")
        s.index()
    def index(s):
        with open(os.path.join(s.dir, "INDEX.md"), "w") as f:
            f.write("# decision map index (generated by pmap; do not edit). id | status | title\n")
            for k in sorted(s.nodes):
                n = s.nodes[k]; f.write(f"{k} | {n.get('status','-')} | {n['title'][:90]}\n")
    def t(s, i): n = s.nodes.get(i); return f"{i} {n['title'][:70]}" if n else f"{i} (MISSING)"
    def up(s, i, depth=6):
        """chain of drivers/goals above node i (who), BFS, goals last"""
        seen, out, fr = {i}, [], [i]
        for _ in range(depth):
            nx = []
            for x in fr:
                n = s.nodes.get(x, {})
                for y in n.get("required_by", []) + n.get("serves", []):
                    if y not in seen: seen.add(y); out.append(y); nx.append(y)
            fr = nx
            if not fr: break
        return out
    def rev(s, i):
        return [n for n in s.nodes.values() if i in n.get("triggered_by", []) + n.get("required_by", []) + n.get("serves", []) + n.get("supersedes", [])]
    def log(s, cmd, out, seq, note=""):
        with open(s.tele, "a") as f:
            f.write(json.dumps({"ts": int(time.time()), "cmd": cmd, "out_tok": tok(out), "seq": seq, "nodes": len(s.nodes), "note": note}) + "\n")
    def seq(s):
        n = 0
        if os.path.exists(s.tele):
            for l in open(s.tele):
                if '"cmd": "task"' in l: n += 1
        return n

def words(q): return [w for w in re.split(r"\W+", q.lower()) if len(w) > 1]

def cmd_find(m, a):
    ws = words(" ".join(a)); hits = []
    for n in m.nodes.values():
        hay = (n["id"] + " " + n["title"] + " " + n.get("why", "") + " " + " ".join(n.get("area", []))).lower()
        sc = sum(w in hay for w in ws)
        if sc == len(ws) or (ws and sc >= max(1, len(ws) - 1) and len(ws) > 2): hits.append((sc, n))
    hits.sort(key=lambda x: (-x[0], x[1]["id"]))
    out = [f"{n['id']} [{n.get('status','-')}] {n['title'][:80]}" for _, n in hits[:10]]
    if len(hits) > 10: out.append(f"... +{len(hits)-10} more (narrow the words)")
    return "\n".join(out) or "no match"

def cmd_why(m, a):
    exp = None; depth = 3; ids = []
    i = 0
    while i < len(a):
        if a[i] == "--expand": exp = a[i + 1]; i += 2
        elif a[i] == "--depth": depth = int(a[i + 1]); i += 2
        else: ids.append(a[i]); i += 1
    n = m.nodes.get(ids[0]) if ids else None
    if not n: return "unknown id"
    o = [f"{n['id']} [{n.get('status','-')}] {n['title']}",
         f"1 WHY   {n.get('why','(not recorded)')}",
         "2 WHO   " + ("; ".join(m.t(x) for x in n.get("required_by", [])) or "driver UNKNOWN"),
         "  WHEN  " + ("; ".join(m.t(x) for x in n.get("triggered_by", [])) or "trigger not recorded"),
         "3 ROOT  " + (" > ".join(m.up(n["id"])) or "none (no goal linked)")]
    if n.get("supersedes"): o.append("  SUPERSEDES " + ", ".join(n["supersedes"]))
    sup = [x["id"] for x in m.nodes.values() if n["id"] in x.get("supersedes", [])]
    if sup: o.append("  SUPERSEDED BY " + ", ".join(sup))
    lk = n.get("links", {}); o.append("  EVIDENCE " + (", ".join(f"{k}:{len(v)}" for k, v in lk.items() if v) or "none") + ("  VERIFIED: " + n["verified"] if n.get("verified") else "  UNVERIFIED"))
    if exp == "when":
        cur = n.get("triggered_by", []); d = 0
        while cur and d < depth:
            d += 1; nx = []
            for x in cur:
                y = m.nodes.get(x, {}); o.append(f"  <- when{d}: {m.t(x)} | why: {y.get('why','')[:80]}"); nx += y.get("triggered_by", [])
            cur = nx
    if exp == "who":
        for x in m.up(n["id"], depth):
            y = m.nodes.get(x, {}); o.append(f"  ^ who: {m.t(x)} | {y.get('why','')[:80]}")
    return "\n".join(o)

def cmd_effects(m, a):
    top = 10
    if "--top" in a: top = int(a[a.index("--top") + 1]); a = [x for x in a if x not in ("--top", str(top))]
    r = sorted(m.rev(a[0]), key=lambda n: n.get("date", ""), reverse=True)
    by = {}
    for n in r:
        for ar in n.get("area", ["-"]) or ["-"]: by[ar] = by.get(ar, 0) + 1
    o = [f"{len(r)} direct effects; by area: " + ", ".join(f"{k}:{v}" for k, v in sorted(by.items(), key=lambda x: -x[1])[:6])]
    o += [f"{n['id']} [{n.get('status','-')}] {n['title'][:80]}" for n in r[:top]]
    if len(r) > top: o.append(f"... +{len(r)-top} more")
    return "\n".join(o)

def cmd_open(m, a):
    o = []
    for st in ("doing", "open", "unverified"):
        for n in sorted(m.nodes.values(), key=lambda x: x["id"]):
            if n["kind"] == "decision" and n.get("status") == st: o.append(f"{n['id']} [{st}] {n['title'][:85]}")
    return "\n".join(o) or "nothing open"

def cmd_add(m, a):
    n = json.loads(a[0]); n.setdefault("kind", "decision"); n.setdefault("date", time.strftime("%Y-%m-%d"))
    if "id" not in n:
        pfx = os.environ.get("PMAP_PFX", m.name[:2].upper()); k = max([int(x.split("-")[1]) for x in m.nodes if x.startswith(pfx + "-") and x.split("-")[1].isdigit()] + [0]) + 1
        n["id"] = f"{pfx}-{k:03d}"
    m.nodes[n["id"]] = {**m.nodes.get(n["id"], {}), **n}; m.save(); return "saved " + n["id"]

def cmd_done(m, a):
    i = a[0]; n = m.nodes.get(i)
    if not n: return "unknown id"
    commits = [a[j + 1] for j, x in enumerate(a) if x == "--commit"]; ver = a[a.index("--verified") + 1] if "--verified" in a else ""
    if not ver or not (commits or n.get("links", {}).get("commits") or n.get("links", {}).get("deploys")): return "REFUSED: done needs --verified '<how checked>' and a commit or deploy link"
    for c in commits:
        if subprocess.call(["git", "-C", m.repo, "cat-file", "-e", c + "^{commit}"], stderr=subprocess.DEVNULL): return f"REFUSED: commit {c} not found"
        n.setdefault("links", {}).setdefault("commits", []).append(c)
    n["status"] = "done"; n["verified"] = ver + " (" + time.strftime("%Y-%m-%d") + ")"; m.save(); return "done " + i

def cmd_check(m, a):
    o = []
    for n in m.nodes.values():
        for f in ("serves", "required_by", "triggered_by", "supersedes"):
            for x in n.get(f, []):
                if x not in m.nodes: o.append(f"{n['id']}: {f} -> {x} missing")
        if n["kind"] == "decision":
            if not n.get("required_by"): o.append(f"{n['id']}: driver unknown")
            if n.get("status") == "done" and not n.get("verified"): o.append(f"{n['id']}: done without verification")
            if n.get("why", "").lower().startswith(("owner wanted", "because the owner")): o.append(f"{n['id']}: why is a wish, not a reason")
        for c in n.get("links", {}).get("commits", []):
            if subprocess.call(["git", "-C", m.repo, "cat-file", "-e", c + "^{commit}"], stderr=subprocess.DEVNULL): o.append(f"{n['id']}: commit {c} not found")
    return "\n".join(o) or "map ok"

def cmd_task(m, a):
    return f"task {m.seq()+1}: {' '.join(a)[:80]}"

def cmd_snap(m, a):
    # optional: keep a report feed growing. Set PMAP_EXPORT_OUT=/path/to/data.json (and PMAP_EXPORT_NOTES / PMAP_EXPORT_EXPERIMENT).
    out = os.environ.get("PMAP_EXPORT_OUT")
    if out:
        cmd = [os.path.join(os.path.dirname(os.path.abspath(__file__)), "pmap-export"), m.repo, "--out", out]
        for flag, env in (("--notes", "PMAP_EXPORT_NOTES"), ("--experiment", "PMAP_EXPORT_EXPERIMENT")):
            if os.environ.get(env): cmd += [flag, os.environ[env]]
        try: subprocess.run(cmd, capture_output=True, timeout=60)
        except Exception: pass
    return "snapshot " + " ".join(a)[:120]

def cmd_stat(m, a):
    rows = [json.loads(l) for l in open(m.tele)] if os.path.exists(m.tele) else []
    o = [f"nodes {len(m.nodes)} ({sum(n['kind']=='decision' for n in m.nodes.values())} decisions); pmap calls {len([r for r in rows if r['cmd'] not in ('task','snap','stat')])}"]
    seq = 0; b = {}
    for r in rows:
        if r["cmd"] == "task": seq += 1; continue
        k = max(seq, 1); k = (k - 1) // 10; d = b.setdefault(k, {"tasks": set(), "read": 0, "write": 0, "n": 0}); d["tasks"].add(max(seq, 1))
        d["write" if r["cmd"] in ("add", "done") else "read"] += r["out_tok"]; d["n"] += 1
    for k in sorted(b):
        d = b[k]; t = len(d["tasks"]); o.append(f"tasks {k*10+1}-{k*10+10}: {t} tasks, read {d['read']} tok ({d['read']//max(t,1)}/task), write {d['write']} tok, {d['n']} calls")
    snaps = [r for r in rows if r["cmd"] == "snap"]
    if snaps: o.append("snapshots: " + "; ".join(f"t{r['seq']}:{r.get('note','')}" for r in snaps[-6:]))
    return "\n".join(o)

def cmd_bench(m, a):
    import random, tempfile, shutil
    out = ["synthetic growth test (decisions -> tokens per query; why = 3-hop chain, find = 2 words, effects = top 10)"]
    random.seed(1)
    for N in (100, 1000, 5000):
        d = tempfile.mkdtemp(); mm = Map(m.repo, mapdir=d, tele=os.path.join(d, "t.jsonl"))
        goals = [f"G-{i}" for i in range(8)]; drv = [f"R-{i}" for i in range(40)]
        for g in goals: mm.nodes[g] = {"id": g, "kind": "goal", "title": f"goal {g}"}
        for r in drv: mm.nodes[r] = {"id": r, "kind": "driver", "title": f"driver {r}", "serves": [random.choice(goals)], "required_by": []}
        ids = []
        for i in range(N):
            x = f"S-{i:05d}"; trig = [random.choice(ids)] if ids and random.random() < .6 else []; ids.append(x)
            mm.nodes[x] = {"id": x, "kind": "decision", "status": "done", "title": f"decision {i} {random.choice(['web','android','api','admin'])} {random.choice(['header','calendar','fees','auth','notice'])}", "why": "synthetic reason text of typical length for a record", "area": [random.choice(["web", "android", "api"])], "required_by": [random.choice(drv)], "triggered_by": trig, "date": f"2026-{1+i%12:02d}-10"}
        s0 = time.time(); w = [tok(cmd_why(mm, [random.choice(ids), "--expand", "when"])) for _ in range(50)]
        f = [tok(cmd_find(mm, ["calendar", "web"])) for _ in range(20)]
        e = [tok(cmd_effects(mm, [random.choice(drv)])) for _ in range(20)]; e2 = [tok(cmd_effects(mm, [random.choice(ids)])) for _ in range(20)]
        out.append(f"N={N:5d}: why avg {sum(w)//len(w)} max {max(w)} | find avg {sum(f)//len(f)} max {max(f)} | effects(driver) avg {sum(e)//len(e)} max {max(e)} | effects(decision) avg {sum(e2)//len(e2)} | file {os.path.getsize(os.path.join(d,'nodes.jsonl')) if os.path.exists(os.path.join(d,'nodes.jsonl')) else sum(len(json.dumps(x)) for x in mm.nodes.values())//1000} B | 90 queries {int((time.time()-s0)*1000)} ms")
        shutil.rmtree(d)
    return "\n".join(out)

def cmd_report(m, a):
    """per-task cost from the session transcript (real API usage) joined with pmap's own meter. flags: --last N, --transcript FILE"""
    import glob, datetime
    tr = a[a.index("--transcript")+1] if "--transcript" in a else max(glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")), key=os.path.getmtime)
    last = int(a[a.index("--last")+1]) if "--last" in a else 99
    rows = [json.loads(l) for l in open(m.tele)] if os.path.exists(m.tele) else []
    tasks = [r for r in rows if r["cmd"] == "task"]
    if not tasks: return "no tasks logged"
    msgs, seen = [], set()
    for l in open(tr):
        try: d = json.loads(l)
        except Exception: continue
        mm = d.get("message"); 
        if not isinstance(mm, dict) or "usage" not in mm or d.get("type") != "assistant": continue
        k = (mm.get("id"), json.dumps(mm["usage"].get("output_tokens")), d.get("timestamp"))
        if mm.get("id") and mm["id"] in seen: continue
        seen.add(mm.get("id") or k)
        ts = datetime.datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
        u = mm["usage"]; msgs.append((ts, u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0), u.get("cache_read_input_tokens", 0), u.get("output_tokens", 0), (u.get("output_tokens_details") or {}).get("thinking_tokens", 0)))
    now = time.time(); o = ["task | effort | wall | api calls | fresh-in | cache-read | out (think) | 3W calls/tok | 3W share of fresh+out | title"]
    tot = [0, 0, 0, 0]
    for i, t in enumerate(tasks):
        a0 = t["ts"]; a1 = tasks[i+1]["ts"] if i+1 < len(tasks) else now
        mm = [x for x in msgs if a0 <= x[0] < a1]
        fi, cr, ou, th = (sum(x[j] for x in mm) for j in (1, 2, 3, 4))
        pr = [r for r in rows if a0 <= r["ts"] < a1 and r["cmd"] not in ("task", "snap", "stat")]
        pt = sum(r["out_tok"] for r in pr); note = t.get("note", ""); eff = re.search(r"--effort (\w+)", note); title = re.sub(r"--effort \w+", "", note).strip()[:60]
        wall = a1 - a0; w = f"{int(wall//60)}m{int(wall%60):02d}s" + ("+" if i+1 == len(tasks) else "")
        share = f"{100*pt/max(fi+ou,1):.1f}%"
        o.append(f"{t['seq']} | {eff.group(1) if eff else 'medium?'} | {w} | {len(mm)} | {fi} | {cr} | {ou} ({th}) | {len(pr)}/{pt} | {share} | {title}")
    return "\n".join(o[:1] + o[1:][-last:]) + "\nfresh-in = input + cache-written tokens (what is newly paid per call); cache-read is re-read context; wall time includes owner wait; last row '+' = still running"

CMDS = {"find": cmd_find, "why": cmd_why, "effects": cmd_effects, "open": cmd_open, "add": cmd_add, "done": cmd_done, "check": cmd_check, "task": cmd_task, "snap": cmd_snap, "stat": cmd_stat, "report": cmd_report, "bench": cmd_bench}

if __name__ == "__main__":
    if len(sys.argv) < 3 or sys.argv[2] not in CMDS: print(__doc__); sys.exit(1)
    m = Map(resolve_repo(sys.argv[1])); c = sys.argv[2]
    out = CMDS[c](m, sys.argv[3:]); print(out)
    seq = m.seq() + (1 if c == "task" else 0)
    m.log(c, out, seq, " ".join(sys.argv[3:]) if c in ("snap", "task") else "")
